PORT=5000

# Prefer the standard mongodb:// form: mongodb+srv:// needs a DNS SRV lookup,
# which some routers/ISPs fail ("querySrv ENOTFOUND _mongodb._tcp...").
# Get it from Atlas > Connect > Drivers > choose an old driver version (e.g. Node 2.2.12).
MONGODB_URI=mongodb://<user>:<db_password>@<shard-00-00>:27017,<shard-00-01>:27017,<shard-00-02>:27017/skin_disease?tls=true&replicaSet=<replica-set>&authSource=admin&retryWrites=true&w=majority
# Optional: resolvers to use if you keep mongodb+srv:// (e.g. 8.8.8.8,1.1.1.1)
MONGODB_DNS_SERVERS=
# Resolve Atlas hosts via DNS-over-HTTPS (1.1.1.1) when the OS resolver fails. Set false to disable.
MONGODB_DOH_FALLBACK=true

JWT_SECRET=change-me-to-a-long-random-string
# Comma-separated browser origins allowed to call the API (admin portal)
CORS_ORIGINS=http://localhost:5173,http://localhost:4173,http://localhost:8081
# Optional: base URL stored in imageUrl for uploaded photos.
# Leave empty to use the host the request came in on (e.g. your LAN IP from a phone).
PUBLIC_BASE_URL=
JWT_EXPIRES_IN=7d
# Set to true when running behind nginx/a load balancer (correct client IPs for rate limits)
TRUST_PROXY=false

# --- Email (Send to Dermatologist) ---------------------------------------
# Leave SMTP_HOST empty in development: emails are saved to feedback-api/outbox/*.eml.
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_SECURE=true,
#        SMTP_USER=you@gmail.com, SMTP_PASS=<16-char App Password, not your Gmail password>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="SkinAI <no-reply@skinai.local>"

# DEV ONLY: password for accounts created by `npm run seed` (defaults to the value in the script)
SEED_PASSWORD=

# --- AI service -----------------------------------------------------------
# The phone never calls FastAPI directly: POST /api/predictions (JWT) forwards here.
FASTAPI_URL=http://127.0.0.1:8001
AI_TIMEOUT_MS=60000

# Development only: also allow browser origins on your private network (see src/config/cors.js)
CORS_ALLOW_LAN=false

# Login/register attempts allowed per IP per 15 minutes (default 20). Raise for local testing only.
AUTH_RATE_LIMIT=20
