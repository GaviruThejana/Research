# Leave empty (recommended): the app calls /api/... on its own origin and the
# Vite dev server proxies it to the Node API, so there's no CORS setup and it
# also works from a phone browser at http://<your-LAN-IP>:5173.
VITE_NODE_API_URL=

# Where the dev server forwards /api and /uploads.
VITE_NODE_API_PROXY_TARGET=http://localhost:5000
