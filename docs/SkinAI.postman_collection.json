                "report"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"predictionId\": \"{{predictionId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Expert queue: pending (saves flagId)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "const d = pm.response.json().data;",
                  "if (d.length) pm.collectionVariables.set(\"flagId\", d[0]._id);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/feedback?status=pending",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "feedback"
              ],
              "query": [
                {
                  "key": "status",
                  "value": "pending"
                }
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Reject flagged prediction",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 (409 if already reviewed)\", () => pm.expect(pm.response.code).to.be.oneOf([200,409]));"
                ]
              }
