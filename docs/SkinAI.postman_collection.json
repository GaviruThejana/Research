    {
      "name": "2. Predictions",
      "item": [
        {
          "name": "Upload image → AI prediction (saves predictionId)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 201\", () => pm.response.to.have.status(201));",
                  "const p = pm.response.json().prediction;",
                  "pm.collectionVariables.set(\"predictionId\", p.id);",
                  "pm.test(\"has a risk level\", () => pm.expect([\"High\", \"Moderate\", \"Low\", \"Unknown\"]).to.include(p.riskLevel));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/predictions",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "predictions"
              ]
            },
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "image",
                  "type": "file",
                  "src": [],
                  "description": "Pick a JPEG/PNG lesion photo (≤ 8 MB)"
                },
                {
                  "key": "metadata",
                  "value": "{\"age\":45,\"sex\":\"female\"}",
                  "type": "text"
                }
              ]
            },
            "description": "Select a file for `image` first. Don't add a Content-Type header: Postman adds the multipart boundary itself."
          }
        },
        {
          "name": "My predictions",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/predictions",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "predictions"
              ]
            }
          }
        }
      ]
    },
