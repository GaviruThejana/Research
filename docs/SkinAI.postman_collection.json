                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/feedback/{{flagId}}/status",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "feedback",
                "{{flagId}}",
                "status"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"rejected\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            }
          }
        }
