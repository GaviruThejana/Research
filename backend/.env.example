# Copy this file to `.env` in the backend/ directory to configure local runs.

SKINAI_APP_NAME=Skin Disease Classification API
SKINAI_APP_VERSION=1.0.0
SKINAI_ENVIRONMENT=development
SKINAI_DEBUG=true

SKINAI_HOST=0.0.0.0
SKINAI_PORT=8001

SKINAI_CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:80

SKINAI_MODEL_DIR=./weights
SKINAI_MODEL_FILENAME=multimodal_skin_net.pth
SKINAI_LABEL_MAP_FILENAME=label_map.json

SKINAI_BACKBONE=resnet50
SKINAI_NUM_CLASSES=7
SKINAI_TOP_K=3
SKINAI_IMAGE_SIZE=224

SKINAI_DEVICE_PREFERENCE=auto

SKINAI_TRAIN_DATA_DIR=./data
SKINAI_CHECKPOINT_DIR=./checkpoints
SKINAI_BATCH_SIZE=32
SKINAI_EPOCHS=10
SKINAI_N_SPLITS=5
SKINAI_LEARNING_RATE=0.001
SKINAI_NUM_WORKERS=2
SKINAI_RANDOM_SEED=42

SKINAI_LOG_LEVEL=INFO
