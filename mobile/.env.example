# The app talks only to the Node API (which forwards predictions to FastAPI).
# Phones/emulators can't reach "localhost" on your PC. Use your PC's LAN IP
# (run `ipconfig`, look for "IPv4 Address"), e.g. 192.168.1.20.
#   Android emulator: http://10.0.2.2:5000      iOS simulator: http://localhost:5000
EXPO_PUBLIC_NODE_API_URL=http://192.168.1.20:5000
